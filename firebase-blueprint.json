{
  "entities": {
    "Contact": {
      "title": "Contact",
      "description": "A professional contact in the CRM",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Full name" },
        "cnpjCpf": { "type": "string", "description": "CPF/CNPJ of the contact" },
        "address": { "type": "string", "description": "Address of the contact" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "phone": { "type": "string", "description": "Phone number" },
        "location": { "type": "string", "description": "Physical location" },
        "status": { 
          "type": "string", 
          "enum": ["Contrato Ativo", "Manutenção Pendente", "Orçamento Enviado", "Instalação Pendente", "Visita Técnica Agendada", "Aguardando Peças", "Serviço Concluído", "Em Negociação"],
          "description": "Relationship status" 
        },
        "portfolioValue": { "type": "string", "description": "Monetary value of the portfolio" },
        "growth": { "type": "string", "description": "Growth percentage or trend" },
        "lastInteraction": { "type": "string", "description": "Date of last interaction" },
        "lastInteractionTime": { "type": "string", "description": "Time of last interaction" },
        "avatar": { "type": "string", "description": "URL to the avatar image" },
        "initials": { "type": "string", "description": "Initials for the contact" },
        "ownerUid": { "type": "string", "description": "UID of the user who owns this contact" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" },
        "equipmentType": { "type": "string", "description": "Type of HVAC equipment" },
        "equipmentBrand": { "type": "string", "description": "Brand of HVAC equipment" },
        "btus": { "type": "string", "description": "BTU capacity" },
        "lastMaintenanceDate": { "type": "string", "format": "date", "description": "Last maintenance date" },
        "nextMaintenanceDate": { "type": "string", "format": "date", "description": "Next maintenance date" },
        "installationDate": { "type": "string", "format": "date", "description": "Installation date" },
        "birthDate": { "type": "string", "format": "date", "description": "Client's date of birth" },
        "financialStatus": { "type": "string", "enum": ["Adimplente", "Inadimplente", "Pendente"], "description": "Financial status of the client" },
        "paymentMethod": { "type": "string", "enum": ["Pix", "Cartão de Crédito", "Dinheiro"], "description": "Preferred payment method" }
      },
      "required": ["name", "address", "email", "cnpjCpf", "ownerUid"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Company settings and preferences",
      "type": "object",
      "properties": {
        "companyName": { "type": "string", "description": "Name of the company" },
        "cnpj": { "type": "string", "description": "Company CNPJ" },
        "email": { "type": "string", "format": "email", "description": "Contact email" },
        "phone": { "type": "string", "description": "Contact phone" },
        "address": { "type": "string", "description": "Company address" },
        "website": { "type": "string", "description": "Company website" },
        "logo": { "type": "string", "description": "Base64 or URL of the company logo" }
      }
    },
    "ServiceOrder": {
      "title": "ServiceOrder",
      "description": "A service order document",
      "type": "object",
      "properties": {
        "contactId": { "type": "string", "description": "ID of the contact this OS belongs to" },
        "contactName": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "materials": { "type": "string" },
        "finalizationNotes": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Aberta", "Finalizada", "Orçamento Aceito", "Orçamento Rejeitado"]
        },
        "value": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerUid": { "type": "string" }
      },
      "required": ["contactId", "subject", "description", "ownerUid", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "A product in the catalog",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Product name" },
        "description": { "type": "string", "description": "Product description" },
        "price": { "type": "string", "description": "Unit price formatted as currency" },
        "category": { "type": "string", "description": "Product category" },
        "stock": { "type": "integer", "description": "Current stock level" },
        "unit": { "type": "string", "description": "Unit of measure (un, kg, m, etc.)" },
        "ownerUid": { "type": "string", "description": "UID of the user who owns this product" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "price", "category", "stock", "unit", "ownerUid", "createdAt"]
    },
    "SystemUser": {
      "title": "SystemUser",
      "description": "A system user with privilege levels and roles",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier" },
        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "format": "email", "description": "Email address" },
        "username": { "type": "string", "description": "Login username" },
        "password": { "type": "string", "description": "Login password" },
        "role": { "type": "string", "description": "Job title or role (Cargo)" },
        "privilege": { 
          "type": "string", 
          "enum": ["Admin", "Técnico", "Vendedor", "Visualizador"],
          "description": "System privilege level" 
        },
        "status": { 
          "type": "string", 
          "enum": ["Ativo", "Inativo"],
          "description": "User status (Active or Inactive)" 
        },
        "ownerUid": { "type": "string", "description": "UID of the user who owns this user entry" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp" }
      },
      "required": ["name", "email", "role", "privilege", "status", "ownerUid", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "A system notification for the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["lead", "os", "contact", "system"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "ownerUid": { "type": "string" }
      },
      "required": ["title", "description", "type", "createdAt", "read", "ownerUid"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "A product or service invoice (Nota Fiscal)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "number": { "type": "string" },
        "series": { "type": "string" },
        "type": { "type": "string", "enum": ["Produto", "Serviço"] },
        "contactId": { "type": "string" },
        "contactName": { "type": "string" },
        "contactCnpjCpf": { "type": "string" },
        "issueDate": { "type": "string", "format": "date" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "totalPrice": { "type": "number" },
              "code": { "type": "string" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["Emitida", "Cancelada", "Rascunho"] },
        "ownerUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "xmlUrl": { "type": "string" },
        "pdfUrl": { "type": "string" },
        "observations": { "type": "string" }
      },
      "required": ["number", "type", "contactId", "contactName", "issueDate", "items", "totalAmount", "status", "ownerUid", "createdAt"]
    }
  },
  "firestore": {
    "/contacts/{contactId}": {
      "schema": "Contact",
      "description": "Collection of professional contacts"
    },
    "/settings/{userId}": {
      "schema": "Settings",
      "description": "User-specific company settings"
    },
    "/service_orders/{osId}": {
      "schema": "ServiceOrder",
      "description": "Collection of service orders (OS) created for contacts"
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of products in the catalog"
    },
    "/system_users/{userId}": {
      "schema": "SystemUser",
      "description": "Collection of system users managed by the admin"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Collection of system notifications"
    },
    "/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Collection of product and service invoices"
    }
  }
}
